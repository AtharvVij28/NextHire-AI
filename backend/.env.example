# Copy this file to .env in the project root (or backend/.env).
# Use one provider. If both keys are set, AI_PROVIDER decides which one runs.

# openai or gemini
AI_PROVIDER=

# OpenAI, or any OpenAI-compatible API (Groq, OpenRouter, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave blank for the official OpenAI API.
OPENAI_BASE_URL=

# Google Gemini (GEMINI_API_KEY or GOOGLE_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local PostgreSQL. Replace YOUR_PASSWORD with the password set during Postgres install.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nexthire
